{
  "name": "mori-music-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Mori browser extension — a floating AI music companion",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "node scripts/build-extension.mjs --watch",
    "dev:host": "node scripts/build-playback-host.mjs --watch --serve",
    "dev:api": "node --watch --env-file-if-exists=.env.local apps/api/server.mjs",
    "build": "node scripts/build-extension.mjs && node scripts/build-playback-host.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "build:host": "node scripts/build-playback-host.mjs",
    "test:api": "npm run test:api:legacy && npm run test:api:graph",
    "test:api:legacy": "MORI_AGENT_RUNTIME=legacy node --test apps/api/test",
    "test:api:graph": "MORI_AGENT_RUNTIME=graph node --test apps/api/test",
    "eval:unified": "node --env-file-if-exists=.env.local apps/api/src/mori-agent/evaluation/run-unified-evaluation.mjs",
    "check": "tsc --noEmit && node scripts/build-extension.mjs && node scripts/build-playback-host.mjs"
  },
  "dependencies": {
    "@langchain/core": "^1.4.1",
    "@langchain/langgraph": "^1.7.5",
    "pg": "^8.23.1",
    "react": "^19",
    "react-dom": "^19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "typescript": "5.7.3"
  }
}
