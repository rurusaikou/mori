{
  "name": "mori-music-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Mori browser extension — a floating AI music companion",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "dev": "node scripts/build-extension.mjs --watch",
    "dev:host": "node scripts/build-playback-host.mjs --watch --serve",
    "build": "node scripts/build-extension.mjs && node scripts/build-playback-host.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "build:host": "node scripts/build-playback-host.mjs",
    "check": "tsc --noEmit && node scripts/build-extension.mjs && node scripts/build-playback-host.mjs"
  },
  "dependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "typescript": "5.7.3"
  }
}
