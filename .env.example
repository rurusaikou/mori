NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://127.0.0.1:3210/spotify/callback

# Desktop playback uses the official Spotify Soloist executable. Keep the API key local and never expose it through NEXT_PUBLIC_*.
MORI_SOLOIST_PATH=/absolute/path/to/soloist
MORI_SOLOIST_API_KEY=
MELODATA_API_KEY=
